# Normaliza finales de línea: LF en el repo, lo que corresponda al hacer checkout.
# Evita ruido en los diffs entre colaboradores en Windows / Mac / Linux.
* text=auto eol=lf

# Binarios: que git no los toque
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
